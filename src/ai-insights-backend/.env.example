# Server Configuration
PORT=22000
HOST=127.0.0.1
AI_INSIGHTS_SERVICE_URL=http://127.0.0.1:22004
FILE_SERVER_PATH="./storage"

# Database Configuration (Docker Compose Shared PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=22003
DB_NAME=docspyre_app
DB_USER=postgres
DB_PASS=

# AI Provider Selection (litellm, gemini, azure, openai, anthropic, ollama, openai-compatible)
AI_PROVIDER=litellm

# LiteLLM Configuration (Default Gateway)
LITELLM_PROXY_URL=http://localhost:22002
LITELLM_MASTER_KEY=
LITELLM_VIRTUAL_KEY=
LITELLM_MODEL=
LITELLM_MODEL_NAME=

# LLM Tracing
AI_LLM_TRACE_ENABLED=true
AI_LLM_TRACE_MAX_CHARS=400000


# Direct Claude: configure ANTHROPIC_API_KEY, ANTHROPIC_MODEL, ANTHROPIC_MAX_TOKENS.
# Direct Ollama: configure OLLAMA_BASE_URL and OLLAMA_MODEL.
# Custom gateways: configure OPENAI_COMPATIBLE_BASE_URL, OPENAI_COMPATIBLE_API_KEY,
# and OPENAI_COMPATIBLE_MODEL with AI_PROVIDER=openai-compatible.
# Optional native mode controls for the exact configured provider/deployment.
# Expert/Fast application analysis works without native controls; no mode is
# assigned to requests that omit chatMode. Azure's model identity is its deployment.
# SPARROW_MODEL_CAPABILITIES={"provider":"litellm","model":"<deployment>","fast":{"reasoning_effort":"low"},"expert":{"reasoning_effort":"high"}}
