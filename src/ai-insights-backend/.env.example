# Server Configuration
PORT=5000
HOST=0.0.0.0
AI_INSIGHTS_SERVICE_URL=http://127.0.0.1:8000
FILE_SERVER_PATH="C:\AI Insights Platform"

# Database Configuration
DB_HOST=localhost
DB_PORT=5434
DB_NAME=AIInsightsApp
DB_USER=postgres
DB_PASS=

# AI Provider Selection (gemini, azure, openai, litellm, anthropic, ollama, openai-compatible)
AI_PROVIDER=gemini

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LLM Tracing
AI_LLM_TRACE_ENABLED=true
AI_LLM_TRACE_MAX_CHARS=400000

# LiteLLM Configuration
LITELLM_PROXY_URL=http://localhost:17002
LITELLM_VIRTUAL_KEY=VIRTUAL_KEY
LITELLM_MASTER_KEY=MASTER_KEY
LITELLM_MODEL=gemini/gemini-3.1-pro-preview
LITELLM_MODEL_NAME=gemini/gemini-3.1-pro-preview

# Tavily
TAVILY_API_KEY=your_tavily_api_key

# Direct Claude: configure ANTHROPIC_API_KEY, ANTHROPIC_MODEL, ANTHROPIC_MAX_TOKENS.
# Direct Ollama: configure OLLAMA_BASE_URL and OLLAMA_MODEL.
# Custom gateways: configure OPENAI_COMPATIBLE_BASE_URL, OPENAI_COMPATIBLE_API_KEY,
# and OPENAI_COMPATIBLE_MODEL with AI_PROVIDER=openai-compatible.
# Optional native mode controls for the exact configured provider/deployment.
# Expert/Fast application analysis works without native controls; no mode is
# assigned to requests that omit chatMode. Azure's model identity is its deployment.
# SPARROW_MODEL_CAPABILITIES={"provider":"litellm","model":"<deployment>","fast":{"reasoning_effort":"low"},"expert":{"reasoning_effort":"high"}}
