{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Compass",
  "version": "1.0.0",
  "identifier": "com.compass.platform",
  "build": {
    "frontendDist": "../../ai-insights-webapp/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev --prefix ../ai-insights-webapp",
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Compass",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Compass - Starting Services",
        "url": "/splash.html",
        "width": 620,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline' 'unsafe-eval' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/bin/**/*",
      "resources/docker/**/*",
      "resources/scripts/**/*",
      "resources/services/backend/**/*",
      "resources/services/python-service/ai-insights-service.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
